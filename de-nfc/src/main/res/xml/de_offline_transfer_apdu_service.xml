<?xml version="1.0" encoding="utf-8"?><!--
    Accesa fork — Digital Euro extensions to the EUDI reference wallet.
    SPDX-License-Identifier: EUPL-1.2

    AID groups for the offline-token NFC transfer (ADR 0011 §6).
    Single proprietary AID, 7 bytes: 0xF0 (ISO 7816-4 §8.2.1.2 "proprietary
    unregistered" RID prefix) followed by the ASCII bytes for "EUDE4B".
    Hex form: F0455544453442 — this is what the manifest aid-filter and the
    reader-side OFFLINE_TRANSFER_AID byteArray must both encode. Android
    HCE requires aid-filter to be an even-length hex string (0-9, A-F),
    so the literal ASCII spelling cannot appear here. Category "other"
    so it doesn't conflict with payment AIDs and doesn't claim to be a
    contactless EMV instrument.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/de_offline_transfer_service_description"
    android:requireDeviceUnlock="false">
    <aid-group
        android:category="other"
        android:description="@string/de_offline_transfer_aid_group_description">
        <aid-filter android:name="F0455544453442" />
    </aid-group>
</host-apdu-service>
